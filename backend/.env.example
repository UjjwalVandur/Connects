# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development          # "development" | "production"

# ─── MongoDB ──────────────────────────────────────────────────────────────────
MONGO_URL=mongodb://localhost:27017/socialdb   # local dev
# MONGO_URL=mongodb+srv://<user>:<pass>@cluster.mongodb.net/socialdb  # Atlas (prod)

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_to_a_long_random_secret
JWT_EXPIRES_IN=1d

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000
