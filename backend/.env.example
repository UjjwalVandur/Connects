# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development          # "development" | "production"

# ─── MongoDB ──────────────────────────────────────────────────────────────────
MONGO_URL=mongodb://localhost:27017/socialdb   # local dev
# MONGO_URL=mongodb+srv://<user>:<pass>@cluster.mongodb.net/socialdb  # Atlas (prod)

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_to_a_long_random_secret
JWT_EXPIRES_IN=1d

# ─── CORS / Frontend ──────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (add your Vercel URL for prod)
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# ─── Cloudinary (required for file uploads) ───────────────────────────────────
# Get these from: cloudinary.com → Dashboard
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── Email (Gmail) — required for forgot-password ─────────────────────────────
# Create an App Password at: myaccount.google.com/apppasswords
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASS=your_gmail_app_password
